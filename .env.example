# Active Dify application: Max AI v2 - PDF Tool Test (Chatflow).
# The public App ID is safe to expose in browser code.
# Dify API requests use the stable user identifier clerk:<Clerk userId>, so
# future App replacements retain the same external user identifier.
NEXT_PUBLIC_APP_ID=61b66232-960e-40e2-a2b6-fa67906d28da

# Legacy Chatbot configuration is intentionally retained as comments in each
# real .env file during migration. Do not reuse its app key for this Chatflow.
# LEGACY_NEXT_PUBLIC_APP_ID=<previous-chatbot-app-id>

# Dify Backend Service API settings.
# Use DIFY_* instead of NEXT_PUBLIC_* because Dify API keys are secrets.
# In Next.js, every NEXT_PUBLIC_* variable is bundled into frontend JavaScript
# and can be read from the browser. Keep the app key server-side only.
# Paste the Backend Service API key created under the new Chatflow's API Access
# page. This key is app-specific and must never use a NEXT_PUBLIC_ prefix.
DIFY_APP_KEY=
DIFY_API_URL=

# Optional read-only conversation archives. The index makes this extensible
# when another Dify App replaces the current version. Archive keys remain
# server-side and must never use a NEXT_PUBLIC_ prefix.
DIFY_ARCHIVE_1_APP_ID=
DIFY_ARCHIVE_1_APP_KEY=
DIFY_ARCHIVE_1_API_URL=
DIFY_ARCHIVE_1_LABEL=Max AI v1

# ISO 8601 time of the latest published Dify Instructions or knowledge-base
# configuration. Conversations created before this time remain readable but
# must start a new chat before sending more messages.
# Update this value whenever the Dify app configuration is published.
# The value must include an explicit timezone offset. Use +08:00 for
# Asia/Shanghai (for example, 2026-07-13T16:20:26+08:00), or use the
# equivalent UTC time ending in Z (for example, 2026-07-13T08:20:26Z).
DIFY_CONFIG_UPDATED_AT=

# Clerk auth.
# main is the production branch, so Vercel Production must use Clerk production
# keys from the production Clerk instance: pk_live_... and sk_live_...
# Use test keys only for local development or Vercel Preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
CLERK_SECRET_KEY=sk_live_...
